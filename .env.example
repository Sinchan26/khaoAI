# OpenAI API Configuration
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Authentication Security
JWT_SECRET_KEY=khaoai-super-secret-key-change-in-prod

# Default Settings
DEFAULT_LOCATION=Salt Lake, Sector V

# Logging Configuration
# Option 1: Global log level for all components (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Option 2: Multi-level / per-component log levels (comma-separated):
# LOG_LEVEL=INFO,graph=DEBUG,mocks=WARNING,api=INFO,auth=INFO

# Option 3: Dedicated component-specific environment variables:
# LOG_LEVEL_GRAPH=DEBUG
# LOG_LEVEL_API=INFO
# LOG_LEVEL_MOCKS=WARNING
# LOG_LEVEL_AUTH=INFO

# Database (Optional — for future PostgreSQL persistence)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/khaoai
