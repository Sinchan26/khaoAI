# OpenAI API Configuration
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Authentication Security
JWT_SECRET_KEY=khaoai-super-secret-key-change-in-prod

# Microservice & Function App Endpoints
MCP_BASE_URL=http://127.0.0.1:7072
AGENT_BASE_URL=http://127.0.0.1:7071
