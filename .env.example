# Runtime
APP_ENV=development
AUTO_CREATE_TABLES=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/khaoai

# Generate long random values; never commit real secrets.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_TOKEN_ENCRYPTION_KEY=

# LLM is optional; deterministic extraction/formatting works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEFAULT_LOCATION=Salt Lake, Sector V
LOCAL_TIMEZONE=Asia/Kolkata

# Official read-only Swiggy MCP
SWIGGY_MCP_URL=https://mcp.swiggy.com/food
SWIGGY_OAUTH_BASE_URL=https://mcp.swiggy.com
SWIGGY_REDIRECT_URI=http://localhost:8000/api/providers/swiggy/callback
SWIGGY_CACHE_TTL_SECONDS=120
SWIGGY_REQUEST_TIMEOUT_SECONDS=20

# Test fixtures are disabled during normal live use.
FIXTURE_PROVIDER_ENABLED=false

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DEBUG_ENDPOINTS_ENABLED=true
LOG_LEVEL=INFO
